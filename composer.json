{
  "name": "andersundsehr/redirects-tweak",
  "description": "Seperates redirects from the page cache and allows to delete redirects where the page was deleted",
  "license": [
    "GPL-2.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "typo3/cms-redirects": "^13.4 || ^14.3"
  },
  "require-dev": {
    "composer/composer": "^2.5.5",
    "pluswerk/grumphp-config": "^11.0.5",
    "saschaegerer/phpstan-typo3": "^2.0.0 || ^3.0.1",
    "ssch/typo3-rector": "^3.1.0",
    "typo3/testing-framework": "^9.2.0"
  },
  "autoload": {
    "psr-4": {
      "AUS\\RedirectsTweak\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AUS\\RedirectsTweak\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "lock": false
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "redirects_tweak"
    }
  },
  "scripts": {
    "test": "@test:functional",
    "test:functional": "@php ./vendor/bin/phpunit --color=always --testdox --configuration phpunit.xml Tests/Functional/",
    "test:unit": "@php ./vendor/bin/phpunit --color=always --testdox --testsuite=Unit Tests/Unit/"
  }
}
