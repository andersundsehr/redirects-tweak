{
  "name": "andersundsehr/redirects-tweak",
  "description": "Seperates redirects from the page cache and allows to delete redirects where the page was deleted",
  "license": [
    "GPL-2.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "require": {
    "typo3/cms-redirects": "^11.5 || ^12.4 || ^13.4"
  },
  "require-dev": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "composer/composer": "^2.5.5",
    "pluswerk/grumphp-config": "*",
    "saschaegerer/phpstan-typo3": "*",
    "ssch/typo3-rector": "^2.5.0 || ^3.8.0",
    "typo3/testing-framework": "^7.1.1 || ^8.2.7 || ^9.2.0"
  },
  "autoload": {
    "psr-4": {
      "AUS\\RedirectsTweak\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AUS\\RedirectsTweak\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "lock": false
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "redirects_tweak"
    }
  },
  "scripts": {
    "test": "@php ./vendor/bin/phpunit --color=always --testdox --testsuite=Unit Tests/Unit/"
  }
}
